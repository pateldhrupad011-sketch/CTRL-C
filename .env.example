# Copy to .env.local (local) or set in your host's dashboard (production).

# Public URL of the site, used for metadata, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=

# Admin panel at /admin — both are required, otherwise sign-in is disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional. Long random string used to sign admin sessions.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional. Folder where form submissions are stored (default: ./data).
# Must be on a persistent disk.
DATA_DIR=

# Firebase Client SDK — public config from Firebase console → Project Settings → General.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK — required for the participant database (server-only).
# Get these from Firebase console → Project Settings → Service Accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the raw key value (with literal \n). Wrap in double quotes.
FIREBASE_PRIVATE_KEY=
