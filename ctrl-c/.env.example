# Copy to .env.local (local) or set in your host's dashboard (production).

# Public URL of the site, used for metadata, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=

# Admin panel at /admin — both are required, otherwise sign-in is disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional. Long random string used to sign admin sessions.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional. Folder where form submissions are stored (default: ./data).
# Must be on a persistent disk.
DATA_DIR=
